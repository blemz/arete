# ═══════════════════════════════════════════════════════════════════════════════
# ARETE PHILOSOPHY TUTOR - ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# 1. DATABASE CONFIGURATION (Required)
# ═══════════════════════════════════════════════════════════════════════════════

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Weaviate Vector Database
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
WEAVIATE_ADDITIONAL_HEADERS=

# ═══════════════════════════════════════════════════════════════════════════════
# 2. ACTIVE PROVIDER SELECTION (Quick Start)
# ═══════════════════════════════════════════════════════════════════════════════

# Primary LLM Provider
# Options: openai | openrouter | gemini | anthropic | ollama
# Recommendation: openai (best performance) or openrouter (cost-effective)
SELECTED_LLM_PROVIDER=openai

# Primary LLM Model (optional - uses provider default if not set)
# OpenAI: gpt-4o-mini, gpt-4o, o3-mini
# For OpenRouter: x-ai/grok-4-fast:free, deepseek/deepseek-chat-v3.1:free, qwen/qwen3-235b-a22b:free.
# Gemini: gemini-2.0-flash-exp, gemini-2.5-pro
# Anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# Ollama: gemma3:12b-it-qat (local)
SELECTED_LLM_MODEL=x-ai/grok-4-fast:free

# Embedding Provider
# Options: openai | voyage | gemini | openrouter | ollama
# Recommendation: openai (best quality) or voyage (best price/performance)
EMBEDDING_PROVIDER=openai

# Embedding Model
# OpenAI: text-embedding-3-small (1536d), text-embedding-3-large (3072d)
# Voyage: voyage-3-lite (512d), voyage-3-large (1024d)
# Gemini: text-embedding-004 (768d)
# Ollama: nomic-embed-text (768d), qwen3-embedding-8b (8192d)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ═══════════════════════════════════════════════════════════════════════════════
# 3. CLOUD PROVIDER API KEYS
# ═══════════════════════════════════════════════════════════════════════════════

# Get your API keys from:
# OpenAI: https://platform.openai.com/api-keys
# OpenRouter: https://openrouter.ai/keys
# Gemini: https://makersuite.google.com/app/apikey
# Anthropic: https://console.anthropic.com/
# Voyage: https://www.voyageai.com/

OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# 4. KNOWLEDGE GRAPH LLM (Advanced Entity/Relationship Extraction)
# ═══════════════════════════════════════════════════════════════════════════════

# Use more powerful models for philosophical concept extraction
# Recommendations:
# - Production: openai + gpt-4o-mini (best balance)
# - High Accuracy: anthropic + claude-3-5-sonnet-20241022
# - Budget: openrouter + qwen/qwen3-235b-a22b (free tier)
# - Local: ollama + gemma3:12b-it-qat (privacy-preserving)
#
# See REFERENCE section at bottom for detailed model comparison

KG_LLM_PROVIDER=openai
KG_LLM_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════════════════════════════
# 5. LLM CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=600
LLM_RETRY_ATTEMPTS=3

# ═══════════════════════════════════════════════════════════════════════════════
# 6. EMBEDDING CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Batch size for embedding generation
MAX_EMBEDDING_BATCH_SIZE=100

# Available Embedding Models by Provider:
#
# OpenAI (Recommended for production):
#   - text-embedding-3-small: 1536d, $0.02/1M tokens
#   - text-embedding-3-large: 3072d, $0.13/1M tokens
#
# Voyage (Best price/performance):
#   - voyage-3-lite: 512d, $0.02/1M tokens, fast
#   - voyage-3-large: 1024d, $0.12/1M tokens, SOTA quality
#
# Gemini (Good quality, competitive pricing):
#   - text-embedding-004: 768d, free tier available
#
# Ollama (Local, free, privacy-preserving):
#   - nomic-embed-text: 768d, good quality/speed
#   - qwen3-embedding-8b: 8192d, MTEB #1, requires 8GB RAM

# ═══════════════════════════════════════════════════════════════════════════════
# 7. APPLICATION CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

APP_NAME=Arete Philosophy Tutor
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# Text Processing
MAX_CONTEXT_LENGTH=5000
CHUNK_SIZE=2048
CHUNK_OVERLAP=512

# File Processing
MAX_FILE_SIZE_MB=100
SUPPORTED_FORMATS=pdf,txt,md,xml,tei
PDF_EXTRACTION_METHOD=pymupdf4llm

# ═══════════════════════════════════════════════════════════════════════════════
# 8. RETRIEVAL CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Hybrid retrieval weights (must sum to 1.0)
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# Retrieval parameters
TOP_K_PASSAGES=5
MAX_GRAPH_DEPTH=2

# ═══════════════════════════════════════════════════════════════════════════════
# 9. PERFORMANCE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

WORKER_PROCESSES=4
CACHE_TTL_SECONDS=3600
MAX_CONCURRENT_REQUESTS=10

# ═══════════════════════════════════════════════════════════════════════════════
# 10. SECURITY CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# ═══════════════════════════════════════════════════════════════════════════════
# 11. OPTIONAL: LOCAL OLLAMA CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Only needed if using SELECTED_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b-it-qat
OLLAMA_TIMEOUT=120

# ═══════════════════════════════════════════════════════════════════════════════
# REFERENCE: LLM MODEL COMPARISON FOR KNOWLEDGE GRAPH EXTRACTION
# ═══════════════════════════════════════════════════════════════════════════════
#
# Use this table to choose the best KG_LLM_PROVIDER and KG_LLM_MODEL above
#
# ┌─────────────────────────┬────────────────────────────────────┬─────────────────────┬──────────────────────┐
# │ Model                   │ Performance & Reasoning            │ Cost (Input/Output) │ Best For             │
# ├─────────────────────────┼────────────────────────────────────┼─────────────────────┼──────────────────────┤
# │ OpenAI GPT-4o-mini      │ Excellent balance. Smart enough    │ $0.15 / $0.60       │ ★ RECOMMENDED        │
# │                         │ for complex philosophical concepts │ per 1M tokens       │ Production use       │
# │                         │ while remaining cost-effective     │                     │ Best cost/performance│
# ├─────────────────────────┼────────────────────────────────────┼─────────────────────┼──────────────────────┤
# │ OpenAI GPT-4o           │ Top-tier reasoning, excellent for  │ $2.50 / $10.00      │ High accuracy needs  │
# │                         │ nuanced philosophical extraction   │ per 1M tokens       │ Research & R&D       │
# ├─────────────────────────┼────────────────────────────────────┼─────────────────────┼──────────────────────┤
# │ OpenAI o3-mini          │ Advanced reasoning model           │ $1.10 / $4.40       │ Complex reasoning    │
# │                         │ Best for multi-step inference      │ per 1M tokens       │ Difficult extractions│
# ├─────────────────────────┼────────────────────────────────────┼─────────────────────┼──────────────────────┤
# │ Claude 3.5 Sonnet       │ Strong performance, excellent      │ $3.00 / $15.00      │ Alternative to GPT-4 │
# │                         │ instruction following              │ per 1M tokens       │ Balanced approach    │
# ├─────────────────────────┼────────────────────────────────────┼─────────────────────┼──────────────────────┤
# │ Claude 3.5 Haiku        │ Fast, cost-effective, still quite  │ $0.80 / $4.00       │ Budget production    │
# │                         │ capable for entity extraction      │ per 1M tokens       │ High throughput      │
# ├─────────────────────────┼────────────────────────────────────┼─────────────────────┼──────────────────────┤
# │ Gemini 2.0 Flash        │ Fast and efficient, good for       │ $0.30 / $1.20       │ Cost-effective       │
# │                         │ general tasks and real-time apps   │ per 1M tokens       │ High-volume ingestion│
# ├─────────────────────────┼────────────────────────────────────┼─────────────────────┼──────────────────────┤
# │ Gemini 2.5 Pro          │ State-of-the-art for complex       │ $1.25-2.50 / $5-10  │ R&D, highest accuracy│
# │                         │ reasoning and long context         │ per 1M tokens       │ Complex texts        │
# ├─────────────────────────┼────────────────────────────────────┼─────────────────────┼──────────────────────┤
# │ Ollama gemma3:12b       │ Good performance for local         │ FREE                │ Privacy-preserving   │
# │                         │ processing. Requires 12GB RAM      │ (local inference)   │ Budget development   │
# ├─────────────────────────┼────────────────────────────────────┼─────────────────────┼──────────────────────┤
# │ OpenRouter              │ Access to multiple models via      │ Varies by model     │ Model experimentation│
# │ qwen3-235b-a22b         │ single API. Strong free tier       │ (free tier)         │ Cost optimization    │
# └─────────────────────────┴────────────────────────────────────┴─────────────────────┴──────────────────────┘
#
# QUICK RECOMMENDATIONS:
# ────────────────────────────────────────────────────────────────────────────────
# Production (Best Overall):   openai + gpt-4o-mini
# High Accuracy:               openai + gpt-4o or anthropic + claude-3-5-sonnet-20241022
# Budget/Privacy:              ollama + gemma3:12b-it-qat
# Development/Testing:         openrouter + qwen3-235b-a22b (free tier)
# High-Volume Processing:      gemini + gemini-2.0-flash-exp
# ════════════════════════════════════════════════════════════════════════════════